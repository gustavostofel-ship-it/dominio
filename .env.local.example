# Copie este arquivo para .env.local e preencha com as credenciais do seu
# projeto Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Usada apenas em server actions (nunca exposta ao navegador) para convidar
# novos usuários da conta via Supabase Auth Admin API.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
